{
  "version": 2,
  "builds": [
    {
      "src": "YB/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "YB/django_backend/yeedem_project/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/YB/django_backend/yeedem_project/wsgi.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/YB/django_backend/yeedem_project/wsgi.py"
    },
    {
      "src": "/static/admin/(.*)",
      "dest": "/YB/django_backend/yeedem_project/wsgi.py"
    },
    {
      "src": "/static/rest_framework/(.*)",
      "dest": "/YB/django_backend/yeedem_project/wsgi.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/vite.svg",
      "dest": "/vite.svg"
    },
    {
      "src": "/((?!api|admin|static/admin|static/rest_framework).*)",
      "dest": "/index.html"
    }
  ]
}
